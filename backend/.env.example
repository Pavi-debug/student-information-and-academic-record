# Backend Environment Configuration Template

# Server Port
PORT=5000

# MongoDB Connection String (Replace with your local or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/student_management

# JWT Secret Key (Use a strong random secret key in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend Client URL (For CORS validation)
CLIENT_URL=http://localhost:5173
